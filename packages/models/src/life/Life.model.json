{
  "schemaVersion": 2,
  "id": "life",
  "label": "Game of Life",
  "description": "John Conway's Game of Life (Martin Gardner, Scientific American, October 1970): a two-dimensional cellular automaton in which a live cell survives with two or three live neighbors and a dead cell comes alive with exactly three. Simple local rules produce oscillators, gliders that travel across the lattice and long-lived chaotic growth, and it is the standard demonstration of emergence in agent-based systems. Updating is synchronous: every cell counts its live neighbours (the Count rule) before any cell changes (the Update rule). The lattice is periodic unless its Periodic parameter is off; the start is a random soup or a known pattern in the middle. Departures from the coded model this was written from: the pattern parameter's option is rPentomino, not r-pentomino, since option IDs have no hyphen; and the width, the height and Periodic are parameters of the lattice.",
  "language": "typescript",
  "attributes": {
    "density": {
      "type": "real",
      "label": "Density",
      "description": "Probability that a cell starts alive (random pattern only).",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    "pattern": {
      "type": "state",
      "label": "Pattern",
      "description": "Starting configuration: random soup, or a known pattern in the middle.",
      "options": {
        "random": {
          "label": "Random"
        },
        "glider": {
          "label": "Glider"
        },
        "blinker": {
          "label": "Blinker"
        },
        "rPentomino": {
          "label": "R-pentomino"
        }
      },
      "defaultOption": "random"
    }
  },
  "acts": {
    "setUp": {
      "kind": "build",
      "label": "Set up",
      "description": "Builds the lattice with a dead cell in every site, then, for a named starting pattern, brings its cells to life in the middle of the lattice.",
      "targets": ["fillLattice", "originX"]
    },
    "fillLattice": {
      "kind": "buildGrid",
      "label": "Fill lattice",
      "selected": "setUp",
      "agents": [],
      "space": "world",
      "fillAgent": "cell"
    },
    "originX": {
      "kind": "evaluate",
      "label": "Pattern column",
      "description": "The column of the pattern's top left corner: half the width, rounded down, less one (so a pattern of three cells across is centred). The pattern's cells are placed relative to it.",
      "selected": "setUp",
      "function": "div",
      "inputs": [
        {
          "attribute": "world.width"
        },
        {
          "literal": 2
        }
      ],
      "targets": ["originXLess"]
    },
    "originXLess": {
      "kind": "evaluate",
      "selected": "setUp",
      "function": "decrement",
      "inputs": [
        {
          "evaluate": "originX"
        }
      ],
      "targets": ["originY"]
    },
    "originY": {
      "kind": "evaluate",
      "label": "Pattern row",
