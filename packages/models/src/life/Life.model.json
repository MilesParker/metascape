  "agents": {
    "cell": {
      "kind": "agent",
      "label": "Cell",
      "pluralLabel": "Cells",
      "description": "A site of the lattice: alive or dead.",
      "attributes": {
        "on": {
          "type": "boolean",
          "label": "Alive",
          "description": "Whether the cell is alive.",
          "gatherData": true
        },
        "live": {
          "type": "integer",
          "label": "Live neighbours",
          "description": "The live neighbours the cell counted in the latest Count rule."
        }
      },
      "acts": {
        "seed": {
          "kind": "initialize",
          "label": "Seed",
          "space": "world",
          "description": "In the random start, the cell is alive with the probability of the density; with a named pattern, every cell starts dead and the pattern was placed when the model was built.",
          "targets": ["isRandom"]
        },
        "isRandom": {
          "kind": "query",
          "selected": "seed",
          "function": "equal",
          "inputs": [
            {
              "attribute": "pattern"
            },
            {
              "option": "pattern.random"
            }
          ],
          "targets": ["draw"]
        },
        "draw": {
          "kind": "evaluate",
          "selected": "seed",
          "function": "randomUnit",
          "targets": ["drawnAlive"]
        },
        "drawnAlive": {
          "kind": "query",
          "selected": "seed",
          "function": "lesser",
          "inputs": [
            {
              "evaluate": "draw"
            },
            {
              "attribute": "density"
            }
          ],
          "targets": ["setAlive"]
        },
        "setAlive": {
          "kind": "set",
          "selected": "seed",
          "attribute": "cell.on",
          "parameter": {
            "constant": "true"
          }
        },
        "count": {
          "kind": "rule",
          "label": "Count",
          "space": "world",
          "description": "First half of a synchronous update: each cell counts its live neighbours and keeps the count, without changing state, so the count does not depend on the order cells run in.",
          "targets": ["clearCount", "neighbors"]
        },
        "clearCount": {
          "kind": "set",
          "selected": "count",
          "attribute": "cell.live",
          "parameter": {
            "constant": "zero"
          }
        },
        "neighbors": {
          "kind": "select",
          "selected": "count",
          "agent": "cell",
          "space": "world",
          "description": "Every neighbouring cell (the eight of a Moore neighbourhood) that is alive: each adds one to the count.",
          "targets": ["neighbor", "everyNeighbor", "neighborAlive"]
        },
        "neighbor": {
          "kind": "query",
          "selected": "neighbors",
          "function": "neighbor",
          "targets": ["liveNeighbors"]
        },
        "everyNeighbor": {
          "kind": "query",
          "selected": "neighbors",
          "function": "all",
          "targets": ["liveNeighbors"]
        },
        "neighborAlive": {
          "kind": "query",
          "selected": "neighbors",
          "function": "identity",
          "inputs": [
            {
              "attribute": "cell.on"
            }
          ],
          "targets": ["liveNeighbors"]
        },
        "liveNeighbors": {
          "kind": "all",
          "selected": "neighbors",
          "targets": ["oneMore"]
        },
        "oneMore": {
          "kind": "evaluate",
          "selected": "count",
          "function": "increment",
          "inputs": [
            {
              "attribute": "cell.live"
            }
          ],
          "targets": ["setCount"]
        },
        "setCount": {
          "kind": "set",
          "selected": "count",
          "attribute": "cell.live",
          "parameter": {
            "evaluate": "oneMore"
          }
        },
        "update": {
          "kind": "rule",
          "label": "Update",
          "space": "world",
          "description": "Second half of the update: every cell takes its next state at once, after all have counted. The three rules of Life: a live cell with two or three live neighbours survives, a dead cell with exactly three comes alive, and every other cell is dead. Written as: alive with three, or alive with two if it was alive already.",
          "targets": ["three", "alive", "two"]
        },
        "three": {
          "kind": "query",
          "selected": "update",
          "function": "equal",
          "inputs": [
            {
              "attribute": "cell.live"
            },
            {
              "literal": 3
            }
          ],
          "targets": ["lives", "dies"]
        },
        "alive": {
          "kind": "query",
          "selected": "update",
          "function": "identity",
          "inputs": [
            {
              "attribute": "cell.on"
            }
          ],
          "targets": ["survives"]
        },
        "two": {
          "kind": "query",
          "selected": "update",
          "function": "equal",
          "inputs": [
            {
              "attribute": "cell.live"
            },
            {
              "literal": 2
            }
          ],
          "targets": ["survives"]
        },
        "survives": {
          "kind": "all",
          "selected": "update",
          "targets": ["lives", "dies"]
        },
        "lives": {
          "kind": "any",
          "selected": "update",
          "targets": ["setOn"]
        },
        "dies": {
          "kind": "none",
          "selected": "update",
          "targets": ["setOff"]
        },
        "setOn": {
          "kind": "set",
          "selected": "update",
          "attribute": "cell.on",
          "parameter": {
            "constant": "true"
          }
        },
        "setOff": {
          "kind": "set",
          "selected": "update",
          "attribute": "cell.on",
          "parameter": {
            "constant": "false"
          }
        }
      },
      "execution": {
        "randomOrder": false
      },
      "styles": {
        "cellStyle": {
          "kind": "2d",
          "label": "Cell Style",
          "description": "Alive cells are green, dead cells dark.",
          "acts": {
            "look": {
              "kind": "rule",
              "space": "world",
              "targets": ["isAlive"]
            },
            "isAlive": {
              "kind": "query",
              "selected": "look",
              "function": "identity",
              "inputs": [
                {
                  "attribute": "cell.on"
                }
              ],
              "targets": ["green", "isDead"]
            },
            "isDead": {
              "kind": "none",
              "selected": "look",
              "targets": ["dark"]
            },
            "green": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorRGB",
              "inputs": [
                {
                  "literal": 0.247,
                  "type": "real"
                },
                {
                  "literal": 0.643,
                  "type": "real"
                },
                {
                  "literal": 0.357,
                  "type": "real"
                }
              ],
              "targets": ["fillGreen"]
            },
            "fillGreen": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            },
            "dark": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorRGB",
              "inputs": [
                {
                  "literal": 0.094,
                  "type": "real"
                },
                {
                  "literal": 0.11,
                  "type": "real"
                },
                {
                  "literal": 0.133,
                  "type": "real"
                }
              ],
              "targets": ["fillDark"]
            },
            "fillDark": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            }
          }
        }
      }
    }
  },
  "spaces": {
    "world": {
      "kind": "grid",
      "label": "Lattice",
      "description": "A lattice with a Moore neighbourhood (the eight surrounding cells), periodic unless its Periodic parameter is off.",
      "borderRule": {
        "periodic": "periodic"
      },
      "neighborhood": "moore",
      "dimensions": ["width", "height"],
      "attributes": {
        "width": {
          "type": "integer",
          "label": "Width",
          "description": "Number of columns.",
          "default": 60,
          "min": 3,
          "max": 400
        },
        "height": {
          "type": "integer",
          "label": "Height",
          "description": "Number of rows.",
          "default": 60,
          "min": 3,
          "max": 400
        },
        "periodic": {
          "type": "boolean",
          "label": "Periodic",
          "description": "Make the lattice periodic, so that neighbourhoods are taken modulo its size; otherwise cells beyond the edge are dead. It sets the lattice's border rule: periodic while true, aperiodic while false.",
          "default": true
        }
      }
    }
  }
}
