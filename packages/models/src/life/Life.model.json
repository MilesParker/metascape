  "agents": {
    "cell": {
      "kind": "agent",
      "label": "Cell",
      "pluralLabel": "Cells",
      "description": "A site of the lattice: alive or dead.",
      "attributes": {
        "on": {
          "type": "boolean",
          "label": "Alive",
          "description": "Whether the cell is alive.",
          "gatherData": true
        },
        "live": {
          "type": "integer",
          "label": "Live neighbours",
          "description": "The live neighbours the cell counted in the latest Count rule."
        }
      },
      "acts": {
        "seed": {
          "kind": "initialize",
          "label": "Seed",
          "space": "world",
          "description": "In the random start, the cell is alive with the probability of the density; with a named pattern, every cell starts dead and the pattern was placed when the model was built.",
          "targets": ["isRandom"]
        },
        "isRandom": {
          "kind": "query",
          "selected": "seed",
          "function": "equal",
          "inputs": [
            {
              "attribute": "pattern"
            },
            {
              "option": "pattern.random"
            }
          ],
          "targets": ["draw"]
        },
        "draw": {
          "kind": "evaluate",
          "selected": "seed",
          "function": "randomUnit",
          "targets": ["drawnAlive"]
        },
        "drawnAlive": {
          "kind": "query",
          "selected": "seed",
          "function": "lesser",
          "inputs": [
            {
              "evaluate": "draw"
            },
            {
              "attribute": "density"
            }
          ],
          "targets": ["setAlive"]
        },
        "setAlive": {
          "kind": "set",
          "selected": "seed",
          "attribute": "cell.on",
          "parameter": {
            "constant": "true"
          }
        },
        "count": {
          "kind": "rule",
          "label": "Count",
          "space": "world",
          "description": "First half of a synchronous update: each cell counts its live neighbours and keeps the count, without changing state, so the count does not depend on the order cells run in.",
          "targets": ["clearCount", "ownX", "ownY", "neighbors"]
        },
        "clearCount": {
          "kind": "set",
          "selected": "count",
          "attribute": "cell.live",
          "parameter": {
            "constant": "zero"
          }
        },
        "neighbors": {
          "kind": "select",
          "selected": "count",
          "agent": "cell",
          "space": "world",
          "description": "Every neighbouring cell (the eight of a Moore neighbourhood) that counts, with Wrap on or on this side of the edge, and is alive: each adds one to the count.",
          "targets": ["neighbor", "everyNeighbor", "wrapping", "neighborX", "neighborY"]
        },
        "neighbor": {
          "kind": "query",
          "selected": "neighbors",
          "function": "neighbor",
          "targets": ["counts"]
        },
        "everyNeighbor": {
          "kind": "query",
          "selected": "neighbors",
          "function": "all",
          "targets": ["counts"]
        },
        "wrapping": {
          "kind": "query",
          "description": "With Wrap on, every neighbour counts, those across an edge too.",
          "selected": "neighbors",
          "function": "identity",
          "inputs": [
            {
              "attribute": "wrap"
            }
          ],
          "targets": ["counts"]
        },
        "neighborX": {
          "kind": "evaluate",
          "description": "The neighbour's column.",
          "selected": "neighbors",
          "function": "locationX",
          "targets": ["columnsApart"]
        },
        "neighborY": {
          "kind": "evaluate",
          "description": "The neighbour's row.",
          "selected": "neighbors",
          "function": "locationY",
          "targets": ["rowsApart"]
        },
        "ownX": {
          "kind": "evaluate",
          "description": "The cell's own column.",
          "selected": "count",
          "function": "locationX",
          "targets": ["columnsApart"]
        },
        "ownY": {
          "kind": "evaluate",
          "description": "The cell's own row.",
          "selected": "count",
          "function": "locationY",
          "targets": ["rowsApart"]
        },
        "columnsApart": {
          "kind": "evaluate",
          "selected": "neighbors",
          "function": "sub",
          "inputs": [
            {
              "evaluate": "neighborX"
            },
            {
              "evaluate": "ownX"
            }
          ],
          "targets": ["columnDistance"]
        },
        "rowsApart": {
          "kind": "evaluate",
          "selected": "neighbors",
          "function": "sub",
          "inputs": [
            {
              "evaluate": "neighborY"
            },
            {
              "evaluate": "ownY"
            }
          ],
          "targets": ["rowDistance"]
        },
        "columnDistance": {
          "kind": "evaluate",
          "selected": "neighbors",
          "function": "abs",
          "inputs": [
            {
              "evaluate": "columnsApart"
            }
          ],
          "targets": ["apart"]
        },
        "rowDistance": {
          "kind": "evaluate",
          "selected": "neighbors",
          "function": "abs",
          "inputs": [
            {
              "evaluate": "rowsApart"
            }
          ],
          "targets": ["apart"]
        },
        "apart": {
          "kind": "evaluate",
          "description": "How far the neighbour is from the cell without going across an edge, in columns or rows, whichever is more: 1 on this side of the edge, and at least 2 across it, since the lattice is at least 3 cells wide and high.",
          "selected": "neighbors",
          "function": "max",
          "inputs": [
            {
              "evaluate": "columnDistance"
            },
            {
              "evaluate": "rowDistance"
            }
          ],
          "targets": ["inside"]
        },
        "inside": {
          "kind": "query",
          "description": "The neighbour is on this side of the edge.",
          "selected": "neighbors",
          "function": "lesserorEqual",
          "inputs": [
            {
              "evaluate": "apart"
            },
            {
              "literal": 1
            }
          ],
          "targets": ["counts"]
        },
        "counts": {
          "kind": "any",
          "description": "The neighbours that count: all of them with Wrap on, else those on this side of the edge. Every one is chosen, then tested for being alive.",
          "selected": "neighbors",
          "targets": ["neighborAlive"]
        },
        "neighborAlive": {
          "kind": "query",
          "selected": "neighbors",
          "function": "identity",
          "inputs": [
            {
              "attribute": "cell.on"
            }
          ],
          "targets": ["oneMore"]
        },
        "oneMore": {
          "kind": "evaluate",
          "selected": "count",
          "function": "increment",
          "inputs": [
            {
              "attribute": "cell.live"
            }
          ],
          "targets": ["setCount"]
        },
        "setCount": {
          "kind": "set",
          "selected": "count",
          "attribute": "cell.live",
          "parameter": {
            "evaluate": "oneMore"
          }
        },
        "update": {
          "kind": "rule",
          "label": "Update",
          "space": "world",
          "description": "Second half of the update: every cell takes its next state at once, after all have counted. The three rules of Life: a live cell with two or three live neighbours survives, a dead cell with exactly three comes alive, and every other cell is dead. Written as: alive with three, or alive with two if it was alive already.",
          "targets": ["three", "alive", "two"]
        },
        "three": {
          "kind": "query",
          "selected": "update",
          "function": "equal",
          "inputs": [
            {
              "attribute": "cell.live"
            },
            {
              "literal": 3
            }
          ],
          "targets": ["lives", "dies"]
        },
        "alive": {
          "kind": "query",
          "selected": "update",
          "function": "identity",
          "inputs": [
            {
              "attribute": "cell.on"
            }
          ],
          "targets": ["survives"]
        },
        "two": {
          "kind": "query",
          "selected": "update",
          "function": "equal",
          "inputs": [
            {
              "attribute": "cell.live"
            },
            {
              "literal": 2
            }
          ],
          "targets": ["survives"]
        },
        "survives": {
          "kind": "all",
          "selected": "update",
          "targets": ["lives", "dies"]
        },
        "lives": {
          "kind": "any",
          "selected": "update",
          "targets": ["setOn"]
        },
        "dies": {
          "kind": "none",
          "selected": "update",
          "targets": ["setOff"]
        },
        "setOn": {
          "kind": "set",
          "selected": "update",
          "attribute": "cell.on",
          "parameter": {
            "constant": "true"
          }
        },
        "setOff": {
          "kind": "set",
          "selected": "update",
          "attribute": "cell.on",
          "parameter": {
            "constant": "false"
          }
        }
      },
      "execution": {
        "randomOrder": false
      },
      "styles": {
        "cellStyle": {
          "kind": "2d",
          "label": "Cell Style",
          "description": "Alive cells are green, dead cells dark.",
          "acts": {
            "look": {
              "kind": "rule",
              "space": "world",
              "targets": ["isAlive"]
            },
            "isAlive": {
              "kind": "query",
              "selected": "look",
              "function": "identity",
              "inputs": [
                {
                  "attribute": "cell.on"
                }
              ],
              "targets": ["green", "isDead"]
            },
            "isDead": {
              "kind": "none",
              "selected": "look",
              "targets": ["dark"]
            },
            "green": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorRGB",
              "inputs": [
                {
                  "literal": 0.247,
                  "type": "real"
                },
                {
                  "literal": 0.643,
                  "type": "real"
                },
                {
                  "literal": 0.357,
                  "type": "real"
                }
              ],
              "targets": ["fillGreen"]
            },
            "fillGreen": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            },
            "dark": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorRGB",
              "inputs": [
                {
                  "literal": 0.094,
                  "type": "real"
                },
                {
                  "literal": 0.11,
                  "type": "real"
                },
                {
                  "literal": 0.133,
                  "type": "real"
                }
              ],
              "targets": ["fillDark"]
            },
            "fillDark": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            }
          }
        }
      }
    }
  },
  "spaces": {
    "world": {
      "kind": "grid",
      "label": "Lattice",
      "description": "A lattice with a Moore neighbourhood (the eight surrounding cells), joined at the edges into a torus. The Wrap parameter decides whether the neighbours across an edge count.",
      "borderRule": "periodic",
      "neighborhood": "moore",
      "dimensions": ["width", "height"],
      "attributes": {
        "width": {
          "type": "integer",
          "label": "Width",
          "description": "Number of columns.",
          "default": 60,
          "min": 3,
          "max": 400
        },
        "height": {
          "type": "integer",
          "label": "Height",
          "description": "Number of rows.",
          "default": 60,
          "min": 3,
          "max": 400
        }
      }
    }
  }
}
