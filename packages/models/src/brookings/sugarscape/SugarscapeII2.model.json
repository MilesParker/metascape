{
  "schemaVersion": 2,
  "id": "sugarscapeII2",
  "label": "Sugarscape II-2",
  "description": "As II-1, but sugar grows back one unit per period, so agents gather on the peaks and the population falls to the carrying capacity of the landscape.",
  "language": "typescript",
  "attributes": {
    "sugarMoundness": {
      "type": "real",
      "label": "Sugar moundness",
      "description": "Topology parameter of the two sugar peaks: larger values give narrower peaks.",
      "default": 0.004,
      "min": 0,
      "max": 0.1
    },
    "minVision": {
      "type": "integer",
      "label": "Min vision",
      "description": "The minimum vision an agent may be given on initialization.",
      "default": 1,
      "min": 0,
      "max": 24
    },
    "maxVision": {
      "type": "integer",
      "label": "Max vision",
      "description": "The maximum vision an agent may be given on initialization.",
      "default": 6,
      "min": 0,
      "max": 24
    },
    "minSugarMetabolism": {
      "type": "integer",
      "label": "Min sugar metabolism",
      "description": "The minimum sugar metabolism an agent may be given on initialization.",
      "default": 1,
      "min": 0,
      "max": 10
    },
    "maxSugarMetabolism": {
      "type": "integer",
      "label": "Max sugar metabolism",
      "description": "The maximum sugar metabolism an agent may be given on initialization.",
      "default": 4,
      "min": 0,
      "max": 10
    },
    "minInitialSugar": {
      "type": "integer",
      "label": "Min initial sugar",
      "description": "The minimum sugar an agent may be given on initialization.",
      "default": 0,
      "min": 0,
      "max": 200
    },
    "maxInitialSugar": {
      "type": "integer",
      "label": "Max initial sugar",
      "description": "The maximum sugar an agent may be given on initialization.",
      "default": 30,
      "min": 0,
      "max": 200
    },
    "minDeathAge": {
      "type": "integer",
      "label": "Min death age",
      "description": "The minimum death age an agent may be given on initialization.",
      "default": 60,
      "min": 0,
      "max": 500
    },
    "maxDeathAge": {
      "type": "integer",
      "label": "Max death age",
      "description": "The maximum death age an agent may be given on initialization.",
      "default": 100,
      "min": 0,
      "max": 500
    },
    "initialPopulation": {
      "type": "integer",
      "label": "Initial population",
      "description": "Agents created at setup.",
      "default": 400,
      "min": 0,
      "max": 2500
    }
  },
  "acts": {
    "setUp": {
      "kind": "build",
      "description": "Builds the world: the agents, then a lattice of sugar cells for them to stand on.",
      "targets": ["createAgents", "fillLattice"]
    },
    "createAgents": {
      "kind": "create",
      "description": "Creates the initial population of agents. Each places itself on a free cell and draws its traits in its Initialize act.",
      "selected": "setUp",
      "agent": "sugarAgent",
      "agentCount": {
        "attribute": "initialPopulation"
      }
    },
    "fillLattice": {
      "kind": "buildGrid",
      "description": "Fills the lattice with a sugar cell in every site, one agent at most to a cell. The coded port's lattice is a constant 50 by 50; here the size is a parameter and the peaks of the landscape scale with it.",
      "selected": "setUp",
      "agents": ["sugarAgent"],
      "space": "lattice",
      "fillAgent": "sugarCell"
    }
  },
  "agents": {
    "sugarAgent": {
      "kind": "agent",
      "label": "Sugar Agent",
      "description": "The basic Sugarscape agent of Epstein and Axtell (1996), Growing Artificial Societies, Brookings Institution Press and MIT Press, chapter II (legacy SugarAgent): it has vision, a sugar metabolism, a sugar stock, an age and a death age. Each period the agents act in a fresh random order, each running all its rules before the next (Ascape's agent order).",
      "pluralLabel": "Sugar Agents",
      "attributes": {
        "sugar": {
          "type": "real",
          "description": "Sugar held. It starts as a draw between the minimum and maximum initial sugar, rises by what the agent harvests and falls by its metabolism. Declared real, though it holds whole numbers, because no function turns a real into an integer.",
          "gatherData": true
        },
        "age": {
          "type": "integer",
          "description": "Periods lived. It starts as a draw from 0 to the death age, as in the original, and rises by one each period. No rule of this model reads it.",
          "gatherData": true
        },
        "vision": {
          "type": "integer",
          "description": "How many cells the agent sees along each of the four lattice directions. Drawn between the minimum and maximum vision at setup and fixed after.",
          "gatherData": true
        },
        "sugarMetabolism": {
          "type": "integer",
          "description": "Sugar the agent uses up each period. Drawn between the minimum and maximum sugar metabolism at setup and fixed after.",
          "gatherData": true
        },
        "deathAge": {
          "type": "integer",
          "description": "Drawn between the minimum and maximum death age at setup. The original draws it and the starting age depends on it, but no rule of this model uses it: agents die only of starvation."
        }
      },
      "execution": {
        "order": "agent"
      },
      "acts": {
        "initialize": {
          "kind": "initialize",
          "description": "Setup of each agent, in the legacy order: a random free cell, then death age, age (from 0 to the death age), vision, sugar metabolism and initial sugar. Where a minimum is above its maximum the draw returns the minimum; the coded port throws.",
          "space": "lattice",
          "targets": ["findHome", "drawDeathAge", "drawVision", "drawMetabolism", "drawSugar"]
        },
        "findHome": {
          "kind": "select",
          "description": "A free cell chosen at random, the same distribution as Ascape's findRandomUnoccupiedCell.",
          "selected": "initialize",
          "agent": "sugarCell",
          "space": "lattice",
          "targets": ["homeIsFree"]
        },
        "homeIsFree": {
          "kind": "query",
          "selected": "findHome",
          "function": "available",
          "targets": ["settle"]
        },
        "settle": {
          "kind": "move",
          "description": "Moves to that cell.",
          "selected": "initialize",
          "destination": "findHome"
        },
        "drawDeathAge": {
          "kind": "evaluate",
          "description": "Draws the death age between the minimum and maximum death age.",
          "selected": "initialize",
          "function": "randomInRange",
          "inputs": [
            {
              "attribute": "minDeathAge"
            },
            {
              "attribute": "maxDeathAge"
            }
          ],
          "targets": ["setDeathAge"]
        },
        "setDeathAge": {
          "kind": "set",
          "selected": "initialize",
          "attribute": "sugarAgent.deathAge",
          "parameter": {
            "evaluate": "drawDeathAge"
          },
          "targets": ["drawAge"]
        },
        "drawAge": {
          "kind": "evaluate",
          "description": "Draws the starting age from 0 to the death age, after the death age is set.",
          "selected": "initialize",
          "function": "randomInRange",
          "inputs": [
            {
              "literal": 0
            },
            {
              "attribute": "sugarAgent.deathAge"
            }
          ],
          "targets": ["setAge"]
        },
        "setAge": {
          "kind": "set",
          "selected": "initialize",
          "attribute": "sugarAgent.age",
          "parameter": {
            "evaluate": "drawAge"
          }
        },
        "drawVision": {
          "kind": "evaluate",
          "description": "Draws the vision between the minimum and maximum vision.",
          "selected": "initialize",
          "function": "randomInRange",
          "inputs": [
            {
              "attribute": "minVision"
            },
            {
              "attribute": "maxVision"
            }
          ],
          "targets": ["setVision"]
        },
        "setVision": {
          "kind": "set",
          "selected": "initialize",
          "attribute": "sugarAgent.vision",
          "parameter": {
            "evaluate": "drawVision"
          }
        },
        "drawMetabolism": {
          "kind": "evaluate",
          "description": "Draws the sugar metabolism between the minimum and maximum sugar metabolism.",
          "selected": "initialize",
          "function": "randomInRange",
          "inputs": [
            {
              "attribute": "minSugarMetabolism"
            },
            {
              "attribute": "maxSugarMetabolism"
            }
          ],
          "targets": ["setMetabolism"]
        },
        "setMetabolism": {
          "kind": "set",
          "selected": "initialize",
          "attribute": "sugarAgent.sugarMetabolism",
          "parameter": {
            "evaluate": "drawMetabolism"
          }
        },
        "drawSugar": {
          "kind": "evaluate",
          "description": "Draws the initial sugar between the minimum and maximum initial sugar.",
          "selected": "initialize",
          "function": "randomInRange",
          "inputs": [
            {
              "attribute": "minInitialSugar"
            },
            {
              "attribute": "maxInitialSugar"
            }
          ],
          "targets": ["setSugar"]
        },
        "setSugar": {
          "kind": "set",
          "selected": "initialize",
          "attribute": "sugarAgent.sugar",
          "parameter": {
            "evaluate": "drawSugar"
          }
        },
        "movement": {
          "kind": "rule",
          "description": "Looks along the four lattice directions as far as its vision, and at its own cell, picks the cell with the most sugar, and moves there only if that cell is free (Ascape's findMaximumWithin, then isAvailable). If the best cell is taken, the agent stays where it is.",
          "space": "lattice",
          "targets": ["inSight"]
        },
        "inSight": {
          "kind": "select",
          "description": "The best cell in sight: of the cells along the four lines of sight and its own cell, the one with the most sugar, ties at random (its own cell included), whether or not it is occupied.",
          "selected": "movement",
          "agent": "sugarCell",
          "space": "lattice",
          "targets": ["withinVision", "mostSugar", "orHere"]
        },
        "withinVision": {
          "kind": "query",
          "description": "Cells along the four lattice directions within the agent's vision. The usual within term would be a diamond on this grid, and Sugarscape agents see only along the lattice lines, so the term lineOfSight was added to the format for this model.",
          "selected": "inSight",
          "function": "lineOfSight",
          "inputs": [
            {
              "attribute": "sugarAgent.vision",
              "selected": "movement"
            }
          ],
          "targets": ["best"]
        },
        "mostSugar": {
          "kind": "query",
          "description": "Chooses the cell with the most sugar. The coded port's tolerance of 1e-10 for ties is not reproduced; sugar is whole numbers, so ties are exact.",
          "selected": "inSight",
          "function": "maximize",
          "inputs": [
            {
              "attribute": "sugarCell.sugar"
            }
          ],
          "targets": ["best"]
        },
        "orHere": {
          "kind": "query",
          "description": "The agent's own cell is one of the candidates, so the agent can stay where it is.",
          "selected": "inSight",
          "function": "includeSelf",
          "targets": ["best"]
        },
        "best": {
          "kind": "all",
          "selected": "inSight",
          "targets": ["bestIsFree"]
        },
        "bestIsFree": {
          "kind": "query",
          "description": "Only a free cell is moved to. The query comes after the choice, so a best cell that is taken means the agent stays; a region in the select would instead rule out taken cells before choosing, which is not what Ascape does. The checker warns that the query follows the logic act; this is the model's one diagnostic.",
          "selected": "inSight",
          "function": "available",
          "targets": ["goThere"]
        },
        "goThere": {
          "kind": "move",
          "description": "Moves to the chosen cell.",
          "selected": "movement",
          "destination": "inSight"
        },
        "harvest": {
          "kind": "rule",
          "description": "Takes all the sugar on the agent's cell: the agent's sugar goes up by the cell's, and the cell is emptied (legacy SugarAgent.harvest).",
          "space": "lattice",
          "targets": ["underfoot"]
        },
        "underfoot": {
          "kind": "select",
          "description": "The cell the agent stands on.",
          "selected": "harvest",
          "agent": "sugarCell",
          "space": "lattice",
          "targets": ["here"]
        },
        "here": {
          "kind": "query",
          "selected": "underfoot",
          "function": "here",
          "targets": ["gather"]
        },
        "gather": {
          "kind": "evaluate",
          "selected": "harvest",
          "function": "add",
          "inputs": [
            {
              "attribute": "sugarAgent.sugar"
            },
            {
              "attribute": "sugarCell.sugar",
              "selected": "underfoot"
            }
          ],
          "targets": ["keep"]
        },
        "keep": {
          "kind": "set",
          "selected": "harvest",
          "attribute": "sugarAgent.sugar",
          "parameter": {
            "evaluate": "gather"
          },
          "targets": ["eaten"]
        },
        "eaten": {
          "kind": "set",
          "description": "Empties the cell.",
          "selected": "underfoot",
          "attribute": "sugarCell.sugar",
          "parameter": {
            "literal": 0
          }
        },
        "metabolism": {
          "kind": "rule",
          "description": "Pays the sugar metabolism out of the agent's sugar and ages the agent one period.",
          "targets": ["spend", "older"]
        },
        "spend": {
          "kind": "evaluate",
          "selected": "metabolism",
          "function": "sub",
          "inputs": [
            {
              "attribute": "sugarAgent.sugar"
            },
            {
              "attribute": "sugarAgent.sugarMetabolism"
            }
          ],
          "targets": ["paid"]
        },
        "paid": {
          "kind": "set",
          "selected": "metabolism",
          "attribute": "sugarAgent.sugar",
          "parameter": {
            "evaluate": "spend"
          }
        },
        "older": {
          "kind": "evaluate",
          "selected": "metabolism",
          "function": "increment",
          "inputs": [
            {
              "attribute": "sugarAgent.age"
            }
          ],
          "targets": ["aged"]
        },
        "aged": {
          "kind": "set",
          "selected": "metabolism",
          "attribute": "sugarAgent.age",
          "parameter": {
            "evaluate": "older"
          }
        },
        "starvation": {
          "kind": "rule",
          "description": "Death Starvation: the agent dies when it has no sugar left.",
          "targets": ["noSugar"]
        },
        "noSugar": {
          "kind": "query",
          "description": "True when the agent's sugar is zero or less.",
          "selected": "starvation",
          "function": "lesserorEqual",
          "inputs": [
            {
              "attribute": "sugarAgent.sugar"
            },
            {
              "constant": "zero"
            }
          ],
          "targets": ["starve"]
        },
        "starve": {
          "kind": "die",
          "description": "The agent dies and its cell is free.",
          "selected": "starvation"
        }
      },
      "styles": {
        "agentStyle": {
          "kind": "2d",
          "description": "A red oval for each agent.",
          "acts": {
            "look": {
              "kind": "rule",
              "description": "Draws an agent as a red oval.",
              "space": "lattice",
              "targets": ["red"]
            },
            "red": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorRed",
              "targets": ["circle"]
            },
            "circle": {
              "kind": "evaluate",
              "selected": "look",
              "function": "shapeOval",
              "targets": ["fill"]
            },
            "fill": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            }
          }
        }
      }
    },
    "sugarCell": {
      "kind": "agent",
      "label": "Sugar Cell",
      "description": "A site of the lattice that holds renewable sugar, up to a capacity that the two-peaked landscape sets (legacy SugarCell). The cells keep rule order and run before the agents each period.",
      "pluralLabel": "Sugar Cells",
      "attributes": {
        "sugar": {
          "type": "real",
          "description": "Sugar on the cell now. It starts at capacity, goes to zero when an agent harvests it, and grows back by the cell's growback rule. Declared real, though it holds whole numbers."
        },
        "capacity": {
          "type": "real",
          "description": "The most sugar the cell holds, from 0 to 4 (the legacy MAX_SUGAR). Set once at setup from the two-peaked landscape. Declared real, though it holds whole numbers."
        }
      },
      "acts": {
        "initialize": {
          "kind": "initialize",
          "description": "Sets the cell's capacity from the two-peaked sugar landscape and fills the cell to capacity. Capacity is floor(4 * min(1, e1 + e2) + 0.5), where each e is exp(-moundness * d^2) and d is the Euclidean distance to one of the peaks, not wrapped round the torus. The peaks are at 0.8 and 0.2, and 0.3 and 0.7, of the lattice width and height: cells (40, 10) and (15, 35) on 50 by 50. All 2,500 capacities equal the coded port's (tested). The original cuts the peak positions to whole cells; here they are not cut, which makes no difference at 50 by 50.",
          "space": "lattice",
          "targets": ["column"]
        },
        "column": {
          "kind": "evaluate",
          "description": "The cell's own column, which nothing else in the format gave a cell. The evaluates locationX and locationY were added for this landscape.",
          "selected": "initialize",
          "function": "locationX",
          "targets": ["row"]
        },
        "row": {
          "kind": "evaluate",
          "description": "The cell's own row.",
          "selected": "initialize",
          "function": "locationY",
          "targets": ["peak1X"]
        },
        "peak1X": {
          "kind": "evaluate",
          "description": "Column of the first peak: 0.8 of the lattice width.",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "attribute": "lattice.width"
            },
            {
              "literal": 0.8,
              "type": "real"
            }
          ],
          "targets": ["peak1Y"]
        },
        "peak1Y": {
          "kind": "evaluate",
          "description": "Row of the first peak: 0.2 of the lattice height.",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "attribute": "lattice.height"
            },
            {
              "literal": 0.2,
              "type": "real"
            }
          ],
          "targets": ["across1"]
        },
        "across1": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "sub",
          "inputs": [
            {
              "evaluate": "column"
            },
            {
              "evaluate": "peak1X"
            }
          ],
          "targets": ["down1"]
        },
        "down1": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "sub",
          "inputs": [
            {
              "evaluate": "row"
            },
            {
              "evaluate": "peak1Y"
            }
          ],
          "targets": ["away1"]
        },
        "away1": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "hypotuneuse",
          "inputs": [
            {
              "evaluate": "across1"
            },
            {
              "evaluate": "down1"
            }
          ],
          "targets": ["squared1"]
        },
        "squared1": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "away1"
            },
            {
              "evaluate": "away1"
            }
          ],
          "targets": ["scaled1"]
        },
        "scaled1": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "squared1"
            },
            {
              "attribute": "sugarMoundness"
            }
          ],
          "targets": ["fall1"]
        },
        "fall1": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "neg",
          "inputs": [
            {
              "evaluate": "scaled1"
            }
          ],
          "targets": ["height1"]
        },
        "height1": {
          "kind": "evaluate",
          "description": "How much the first peak contributes at this cell: exp(-moundness * distance^2), where the distance is from this cell to the peak.",
          "selected": "initialize",
          "function": "exp",
          "inputs": [
            {
              "evaluate": "fall1"
            }
          ],
          "targets": ["peak2X"]
        },
        "peak2X": {
          "kind": "evaluate",
          "description": "Column of the second peak: 0.3 of the lattice width.",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "attribute": "lattice.width"
            },
            {
              "literal": 0.3,
              "type": "real"
            }
          ],
          "targets": ["peak2Y"]
        },
        "peak2Y": {
          "kind": "evaluate",
          "description": "Row of the second peak: 0.7 of the lattice height.",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "attribute": "lattice.height"
            },
            {
              "literal": 0.7,
              "type": "real"
            }
          ],
          "targets": ["across2"]
        },
        "across2": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "sub",
          "inputs": [
            {
              "evaluate": "column"
            },
            {
              "evaluate": "peak2X"
            }
          ],
          "targets": ["down2"]
        },
        "down2": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "sub",
          "inputs": [
            {
              "evaluate": "row"
            },
            {
              "evaluate": "peak2Y"
            }
          ],
          "targets": ["away2"]
        },
        "away2": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "hypotuneuse",
          "inputs": [
            {
              "evaluate": "across2"
            },
            {
              "evaluate": "down2"
            }
          ],
          "targets": ["squared2"]
        },
        "squared2": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "away2"
            },
            {
              "evaluate": "away2"
            }
          ],
          "targets": ["scaled2"]
        },
        "scaled2": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "squared2"
            },
            {
              "attribute": "sugarMoundness"
            }
          ],
          "targets": ["fall2"]
        },
        "fall2": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "neg",
          "inputs": [
            {
              "evaluate": "scaled2"
            }
          ],
          "targets": ["height2"]
        },
        "height2": {
          "kind": "evaluate",
          "description": "How much the second peak contributes at this cell: exp(-moundness * distance^2).",
          "selected": "initialize",
          "function": "exp",
          "inputs": [
            {
              "evaluate": "fall2"
            }
          ],
          "targets": ["bothPeaks"]
        },
        "bothPeaks": {
          "kind": "evaluate",
          "description": "The two peaks' contributions added together.",
          "selected": "initialize",
          "function": "add",
          "inputs": [
            {
              "evaluate": "height1"
            },
            {
              "evaluate": "height2"
            }
          ],
          "targets": ["upToOne"]
        },
        "upToOne": {
          "kind": "evaluate",
          "description": "The sum, but at most 1.",
          "selected": "initialize",
          "function": "min",
          "inputs": [
            {
              "evaluate": "bothPeaks"
            },
            {
              "literal": 1.0,
              "type": "real"
            }
          ],
          "targets": ["toCapacity"]
        },
        "toCapacity": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "upToOne"
            },
            {
              "literal": 4,
              "type": "real"
            }
          ],
          "targets": ["roundUp"]
        },
        "roundUp": {
          "kind": "evaluate",
          "selected": "initialize",
          "function": "add",
          "inputs": [
            {
              "evaluate": "toCapacity"
            },
            {
              "literal": 0.5,
              "type": "real"
            }
          ],
          "targets": ["rounded"]
        },
        "rounded": {
          "kind": "evaluate",
          "description": "The capacity: 4 times the capped sum, rounded half up (the legacy Math.round).",
          "selected": "initialize",
          "function": "floor",
          "inputs": [
            {
              "evaluate": "roundUp"
            }
          ],
          "targets": ["setCapacity"]
        },
        "setCapacity": {
          "kind": "set",
          "description": "Stores the capacity.",
          "selected": "initialize",
          "attribute": "sugarCell.capacity",
          "parameter": {
            "evaluate": "rounded"
