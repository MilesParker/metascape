        "growBack": {
          "kind": "rule",
          "description": "Sugar grows back one unit a period, up to capacity (legacy SUGAR_GROW_BACK_1_RULE, 'Sugar-Grow Back 1'). II-1 grows it back to capacity at once; this is the one rule that differs between the two.",
          "space": "lattice",
