{
  "schemaVersion": 2,
  "id": "civilViolenceI",
  "label": "Civil Violence: Model I",
  "description": "Epstein's model of decentralized rebellion against a central authority: citizens turn active when their grievance outweighs their perceived risk of arrest, and cops jail active citizens in view.",
  "language": "typescript",
  "attributes": {
    "initialPopulationDensity": {
      "type": "real",
      "label": "Initial population density",
      "default": 0.7,
      "description": "Citizens as a fraction of lattice sites.",
      "min": 0,
      "max": 1
    },
    "initialCopDensity": {
      "type": "real",
      "label": "Initial cop density",
      "default": 0.04,
      "description": "Cops as a fraction of lattice sites.",
      "min": 0,
      "max": 1
    },
    "copVision": {
      "type": "real",
      "label": "Cop vision",
      "default": 1.7,
      "description": "How far a cop sees an active citizen, in lattice units.",
      "min": 0,
      "max": 16
    },
    "citizenVision": {
      "type": "real",
      "label": "Citizen vision",
      "default": 1.7,
      "description": "How far a citizen sees cops and active citizens, in lattice units.",
      "min": 0,
      "max": 16
    },
    "legitimacy": {
      "type": "real",
      "label": "Legitimacy",
      "default": 0.8,
      "description": "Perceived legitimacy of the central authority; grievance is hardship times one minus legitimacy.",
      "min": 0,
      "max": 1
    },
    "activeThreshold": {
      "type": "real",
      "label": "Active threshold",
      "default": 0.1,
      "description": "A citizen turns active when grievance minus perceived risk exceeds this.",
      "min": 0,
      "max": 1
    },
    "jailTerm": {
      "type": "integer",
      "label": "Jail term",
      "default": 15,
      "description": "Maximum jail term in periods; each term is drawn uniformly from 0 to this. 2147483647 means never released.",
      "min": 0,
      "max": 2147483647
    },
    "citizensMove": {
      "type": "boolean",
      "label": "Citizens move",
      "default": true,
      "description": "Whether citizens walk; cops always do."
    },
    "legitimacyErosion": {
      "type": "real",
      "label": "Legitimacy erosion",
      "default": 0,
      "description": "How much legitimacy falls each time the interval comes round (Run 3: 0.01).",
      "min": 0,
      "max": 1
    },
    "erosionInterval": {
      "type": "integer",
      "label": "Erosion interval",
      "default": 3,
      "description": "Periods between falls in legitimacy.",
      "min": 1,
      "max": 1000
    },
    "legitimacyCutPeriod": {
      "type": "integer",
      "label": "Legitimacy cut period",
      "default": 0,
      "description": "The period at which legitimacy is set to the cut value; 0 for never (Run 4: 75).",
      "min": 0,
      "max": 100000
    },
    "legitimacyCut": {
      "type": "real",
      "label": "Legitimacy cut",
      "default": 0.65,
      "description": "The legitimacy set at the cut period.",
      "min": 0,
      "max": 1
    },
    "copDensityStep": {
      "type": "real",
      "label": "Cop density step",
      "default": 0,
      "description": "How far the cop density falls each period; cops above it are withdrawn (Run 5: 0.001).",
      "min": 0,
      "max": 1
    }
  },
  "acts": {
    "build": {
      "kind": "build",
      "label": "Build",
      "description": "Sets up the world: the number of citizens and cops from the initial densities, then a lattice of sites for them to stand on.",
      "targets": ["sites", "fillLattice"]
    },
    "sites": {
      "kind": "evaluate",
      "selected": "build",
      "function": "mul",
      "inputs": [
        {
          "attribute": "lattice.width"
        },
        {
          "attribute": "lattice.height"
        }
      ],
      "targets": ["citizensWanted", "copsWanted"]
    },
    "citizensWanted": {
      "kind": "evaluate",
      "selected": "build",
      "function": "mul",
      "inputs": [
        {
          "attribute": "initialPopulationDensity"
        },
        {
          "evaluate": "sites"
        }
      ],
      "targets": ["citizenCount"]
    },
    "citizenCount": {
      "kind": "evaluate",
      "description": "How many citizens to create: initial population density times the number of sites (width times height), rounded down, as the coded port truncates.",
      "selected": "build",
      "function": "floor",
      "inputs": [
        {
          "evaluate": "citizensWanted"
        }
      ],
      "targets": ["createCitizens"]
    },
    "createCitizens": {
      "kind": "create",
      "label": "Create Citizens",
      "description": "Creates the citizens. Each places itself and draws its hardship and risk aversion in its Place act.",
      "selected": "build",
      "agent": "citizen",
      "agentCount": {
        "evaluate": "citizenCount"
      }
    },
    "copsWanted": {
      "kind": "evaluate",
      "selected": "build",
      "function": "mul",
      "inputs": [
        {
          "attribute": "initialCopDensity"
        },
        {
          "evaluate": "sites"
        }
      ],
      "targets": ["copCount"]
    },
    "copCount": {
      "kind": "evaluate",
      "description": "How many cops to create: initial cop density times the number of sites, rounded down.",
      "selected": "build",
      "function": "floor",
      "inputs": [
        {
          "evaluate": "copsWanted"
        }
      ],
      "targets": ["createCops"]
    },
    "createCops": {
      "kind": "create",
      "label": "Create Cops",
      "description": "Creates the cops. Each places itself in its Place act.",
      "selected": "build",
      "agent": "cop",
      "agentCount": {
        "evaluate": "copCount"
      }
    },
    "fillLattice": {
      "kind": "buildGrid",
      "label": "Fill Lattice",
      "description": "Fills the lattice with a site in every cell, for the citizens and cops to stand on. Unlike the original, the lattice size is a parameter.",
      "selected": "build",
      "agents": ["citizen", "cop"],
      "space": "lattice",
      "fillAgent": "site"
    },
    "drift": {
      "kind": "rule",
      "label": "Change Legitimacy",
      "description": "Changes legitimacy during a run, for Runs 3 and 4: it falls by the legitimacy erosion every erosion interval, and is set to the legitimacy cut at the cut period. Both are inert at their defaults. The legacy Run 3 and Run 4 classes did this in their own scapeIterated; a run spec only sets values at the start, so here it is a rule of the model that acts on parameters.",
      "targets": ["erodes", "now"]
    },
    "erodes": {
      "kind": "evaluate",
      "selected": "drift",
      "function": "timeNow",
      "targets": ["phase"]
    },
    "phase": {
      "kind": "evaluate",
      "selected": "drift",
      "function": "mod",
      "inputs": [
        {
          "evaluate": "erodes"
        },
        {
          "attribute": "erosionInterval"
        }
      ],
      "targets": ["erosionDue"]
    },
    "erosionDue": {
      "kind": "query",
      "description": "True every erosion interval periods: the period number modulo the interval is zero. Run 3 uses 3.",
      "selected": "drift",
      "function": "equal",
      "inputs": [
        {
          "evaluate": "phase"
        },
        {
          "literal": 0
        }
      ],
      "targets": ["lowered"]
    },
    "lowered": {
      "kind": "evaluate",
      "selected": "drift",
      "function": "sub",
      "inputs": [
        {
          "attribute": "legitimacy"
        },
        {
          "attribute": "legitimacyErosion"
        }
      ],
      "targets": ["floored"]
    },
    "floored": {
      "kind": "evaluate",
      "selected": "drift",
      "function": "max",
      "inputs": [
        {
          "evaluate": "lowered"
        },
        {
          "literal": 0,
          "type": "real"
        }
      ],
      "targets": ["setEroded"]
    },
    "setEroded": {
      "kind": "set",
      "description": "Lowers legitimacy by the erosion, but not below zero, as Run 3 did (if legitimacy - 0.01 > 0 then subtract 0.01, else 0).",
      "selected": "drift",
      "attribute": "legitimacy",
      "parameter": {
        "evaluate": "floored"
      }
    },
    "now": {
      "kind": "evaluate",
      "selected": "drift",
      "function": "timeNow",
      "targets": ["cutEnabled"]
    },
    "cutEnabled": {
      "kind": "query",
      "description": "A legitimacy cut period of 0 means never.",
      "selected": "drift",
      "function": "greater",
      "inputs": [
        {
          "attribute": "legitimacyCutPeriod"
        },
        {
          "literal": 0
        }
      ],
      "targets": ["cutDue"]
    },
    "cutDue": {
      "kind": "query",
      "description": "True at the legitimacy cut period (Run 4 cuts after period 75).",
      "selected": "drift",
      "function": "equal",
      "inputs": [
        {
          "evaluate": "now"
        },
        {
          "attribute": "legitimacyCutPeriod"
        }
      ],
      "targets": ["setCut"]
    },
    "setCut": {
      "kind": "set",
      "description": "Sets legitimacy to the legitimacy cut value (Run 4: 0.65).",
      "selected": "drift",
      "attribute": "legitimacy",
      "parameter": {
        "attribute": "legitimacyCut"
      }
    }
  },
  "agents": {
    "site": {
      "kind": "agent",
      "label": "Site",
      "description": "A cell of the lattice. A site holds at most one agent, citizen or cop, as in the legacy single lattice.",
      "pluralLabel": "Sites",
      "acts": {},
      "styles": {
        "siteStyle": {
          "kind": "2d",
          "description": "Paper-coloured cells (RGB 237, 230, 214), the background of the original's views.",
          "acts": {
            "look": {
              "kind": "rule",
              "description": "Fills the site with the background colour.",
              "space": "lattice",
              "targets": ["paper"]
            },
            "paper": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorRGB",
              "inputs": [
                {
                  "literal": 0.929,
                  "type": "real"
                },
                {
                  "literal": 0.902,
                  "type": "real"
                },
                {
                  "literal": 0.839,
                  "type": "real"
                }
              ],
              "targets": ["fill"]
            },
            "fill": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            }
          }
        }
      }
    },
    "person": {
      "kind": "agent",
      "label": "Person",
      "description": "Not an agent of the model: a type that others extend. It holds what citizens and cops share, the placement on a random free site and the random walk, and each extends it with `extends: \"person\"`. The types are made flat when the model is loaded, so citizen and cop each have their own copies of these acts and nothing in the running model relates them. A selection of `person` would find no citizens and no cops (and `person` is not in the model at all, being abstract).",
      "abstract": true,
      "acts": {
        "place": {
          "kind": "initialize",
          "label": "Place",
          "description": "Setup: the agent moves to a random free site. A type that extends this one replaces `place` to say what else it sets up, since an act's targets are its own.",
          "space": "lattice",
          "targets": ["startSite"]
        },
        "startSite": {
          "kind": "select",
          "description": "A free site, chosen at random.",
          "selected": "place",
          "agent": "site",
          "space": "lattice",
          "targets": ["startFree"]
        },
        "startFree": {
          "kind": "query",
          "selected": "startSite",
          "function": "available",
          "targets": ["startGo"]
        },
        "startGo": {
          "kind": "move",
          "description": "Moves to that site.",
          "selected": "place",
          "destination": "startSite"
        },
        "walk": {
          "kind": "rule",
          "label": "Random Walk",
          "description": "Tries one random neighbouring site and moves there if it is free; otherwise the agent stays (Ascape's random walk). Citizens replace this rule to add their conditions; cops use it as it is.",
          "space": "lattice",
          "targets": ["stepSite"]
        },
        "stepSite": {
          "kind": "select",
          "description": "One neighbouring site, chosen at random. Only one is tried.",
          "selected": "walk",
          "agent": "site",
          "space": "lattice",
          "targets": ["stepAdjacent"]
        },
        "stepAdjacent": {
          "kind": "query",
          "selected": "stepSite",
          "function": "neighbor",
          "targets": ["stepGo"]
        },
        "stepGo": {
          "kind": "move",
          "description": "Moves to that site. A move onto a site that is taken does nothing, so the agent stays, which is Ascape's behaviour without a separate test for a free site.",
          "selected": "walk",
          "destination": "stepSite"
        }
      }
    },
    "citizen": {
      "kind": "agent",
      "extends": "person",
      "label": "Citizen",
      "description": "A person with a fixed hardship and risk aversion, quiescent, active or jailed. Its rules run in this order: walk (unless jailed), check jail, decide state.",
      "pluralLabel": "Citizens",
      "attributes": {
        "state": {
          "type": "state",
          "label": "State",
          "description": "Quiescent (the default), active (rebelling) or jailed. A jailed citizen is off the lattice.",
          "options": {
            "quiescent": {
              "label": "Quiescent"
            },
            "active": {
              "label": "Active"
            },
            "jailed": {
              "label": "Jailed"
            }
          },
          "defaultOption": "quiescent",
          "gatherData": true
        },
        "hardship": {
          "type": "real",
          "label": "Hardship",
          "description": "Perceived hardship, drawn uniformly from 0 to 1 when the citizen is created and fixed after that."
        },
        "riskAversion": {
          "type": "real",
          "label": "Risk aversion",
          "description": "How strongly the citizen weighs the chance of arrest, drawn uniformly from 0 to 1 when the citizen is created and fixed after that.",
          "gatherData": true
        },
        "grievance": {
          "type": "real",
          "label": "Grievance",
          "description": "Hardship times (1 - legitimacy) times (1 - active threshold), read from the current legitimacy and threshold. The legacy code's earlier version, left in a comment, had only the first two factors.",
          "gatherData": true,
          "derived": true,
          "default": 0
        },
        "jailTermsLeft": {
          "type": "integer",
          "label": "Jail periods left",
          "description": "Periods of the jail term still to serve, drawn at arrest and counted down while jailed."
        },
        "homeX": {
          "type": "integer",
          "label": "Home column",
          "description": "Column of the site where the citizen was arrested, where release looks for a place. Attributes cannot hold a cell, so the coordinates are kept (the coded port keeps the cell)."
        },
        "homeY": {
          "type": "integer",
          "label": "Home row",
          "description": "Row of the site where the citizen was arrested; see Home column."
        },
        "copsSeen": {
          "type": "integer",
          "label": "Cops in view",
          "description": "Cops within citizen vision, counted afresh each time the citizen decides its state."
        },
        "activeSeen": {
          "type": "integer",
          "label": "Active citizens in view",
          "description": "Other active citizens within citizen vision, counted afresh each time the citizen decides its state."
        }
      },
      "acts": {
        "place": {
          "kind": "initialize",
          "label": "Place",
          "description": "Setup: the citizen moves to a random free site and draws its hardship and risk aversion, each uniform from 0 to 1. The legacy citizen was placed by an initial rule that moves it to a random location.",
          "space": "lattice",
          "targets": ["startSite", "drawHardship", "drawRisk"]
        },
        "drawHardship": {
          "kind": "evaluate",
          "selected": "place",
          "function": "randomUnit",
          "targets": ["setHardship"]
        },
        "setHardship": {
          "kind": "set",
          "selected": "place",
          "attribute": "citizen.hardship",
          "parameter": {
            "evaluate": "drawHardship"
          }
        },
        "drawRisk": {
          "kind": "evaluate",
          "selected": "place",
          "function": "randomUnit",
          "targets": ["setRisk"]
        },
        "setRisk": {
          "kind": "set",
          "selected": "place",
          "attribute": "citizen.riskAversion",
          "parameter": {
            "evaluate": "drawRisk"
          }
        },
        "grievanceOf": {
          "kind": "derive",
          "label": "Grievance",
          "description": "Computes grievance when it is read: hardship times (1 - legitimacy) times (1 - active threshold), so it follows legitimacy and the threshold as they change.",
          "attribute": "citizen.grievance",
          "targets": ["illegitimacy"]
        },
        "illegitimacy": {
          "kind": "evaluate",
          "selected": "grievanceOf",
          "function": "sub",
          "inputs": [
            {
              "literal": 1,
              "type": "real"
            },
            {
              "attribute": "legitimacy"
            }
          ],
          "targets": ["hardshipShare"]
        },
        "hardshipShare": {
          "kind": "evaluate",
          "selected": "grievanceOf",
          "function": "mul",
          "inputs": [
            {
              "attribute": "citizen.hardship"
            },
            {
              "evaluate": "illegitimacy"
            }
          ],
          "targets": ["aboveThreshold"]
        },
        "aboveThreshold": {
          "kind": "evaluate",
          "selected": "grievanceOf",
          "function": "sub",
          "inputs": [
            {
              "literal": 1,
              "type": "real"
            },
            {
              "attribute": "activeThreshold"
            }
          ],
          "targets": ["grievanceValue"]
        },
        "grievanceValue": {
          "kind": "evaluate",
          "selected": "grievanceOf",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "hardshipShare"
            },
            {
              "evaluate": "aboveThreshold"
            }
          ]
        },
        "walk": {
          "kind": "rule",
          "label": "Random Walk",
          "description": "Unless the citizen is jailed or citizens are set not to move, tries one random neighbouring site and moves there if it is free; otherwise it stays (Ascape's random walk). Replaces the person's `walk`: the same walk (`stepSite`, inherited), behind two conditions.",
          "space": "lattice",
          "targets": ["walkFree"]
        },
        "walkFree": {
          "kind": "query",
          "description": "Jailed citizens do not walk.",
          "selected": "walk",
          "function": "different",
          "inputs": [
            {
              "attribute": "citizen.state"
            },
            {
              "option": "citizen.state.jailed"
            }
          ],
          "targets": ["walkAllowed"]
        },
        "walkAllowed": {
          "kind": "query",
          "description": "Whether citizens walk at all; Run 1 turns it off.",
          "selected": "walk",
          "function": "identity",
          "inputs": [
            {
              "attribute": "citizensMove"
            }
          ],
          "targets": ["stepSite"]
        },
        "release": {
          "kind": "rule",
          "label": "Check Jail",
          "description": "A jailed citizen serves one period of its term. When none is left it becomes quiescent and moves to the free site nearest to where it was arrested. The original searched within 16 sites and, finding none, moved to a random free site; neither the limit nor the fallback is carried over.",
          "space": "lattice",
          "targets": ["serving"]
        },
        "serving": {
          "kind": "query",
          "description": "Only jailed citizens serve a term.",
          "selected": "release",
          "function": "equal",
          "inputs": [
            {
              "attribute": "citizen.state"
            },
            {
              "option": "citizen.state.jailed"
            }
          ],
          "targets": ["tick", "termOver"]
        },
        "tick": {
          "kind": "evaluate",
          "description": "The jail term left, less one.",
          "selected": "release",
          "function": "decrement",
          "inputs": [
            {
              "attribute": "citizen.jailTermsLeft"
            }
          ],
          "targets": ["setTicked"]
        },
        "setTicked": {
          "kind": "set",
          "selected": "release",
          "attribute": "citizen.jailTermsLeft",
          "parameter": {
            "evaluate": "tick"
          }
        },
        "termOver": {
          "kind": "query",
          "description": "True when no periods of the term are left.",
          "selected": "release",
          "function": "lesserorEqual",
          "inputs": [
            {
              "attribute": "citizen.jailTermsLeft"
            },
            {
              "literal": 0
            }
          ],
          "targets": ["setFree", "homeSite"]
        },
        "setFree": {
          "kind": "set",
          "description": "Back to quiescent.",
          "selected": "release",
          "attribute": "citizen.state",
          "parameter": {
            "option": "citizen.state.quiescent"
          }
        },
        "homeSite": {
          "kind": "select",
          "description": "The site where the citizen was arrested, found from the coordinates it kept.",
          "selected": "release",
          "agent": "site",
          "space": "lattice",
          "targets": ["atHome"]
        },
        "atHome": {
          "kind": "query",
          "selected": "homeSite",
          "function": "location2D",
          "inputs": [
            {
              "attribute": "citizen.homeX",
              "selected": "release"
            },
            {
              "attribute": "citizen.homeY",
              "selected": "release"
            }
          ],
          "targets": ["nearHome"]
        },
        "nearHome": {
          "kind": "select",
          "description": "The free site nearest to the arrest site, which counts itself if it is free.",
          "selected": "homeSite",
          "agent": "site",
          "space": "lattice",
          "targets": ["nearFree", "nearest", "orHome"]
        },
        "nearFree": {
          "kind": "query",
          "selected": "nearHome",
          "function": "available",
          "targets": ["nearGroup"]
        },
        "nearest": {
          "kind": "query",
          "selected": "nearHome",
          "function": "nearest",
          "targets": ["nearGroup"]
        },
        "orHome": {
          "kind": "query",
          "selected": "nearHome",
          "function": "includeSelf",
          "targets": ["nearGroup"]
        },
        "nearGroup": {
          "kind": "all",
          "selected": "nearHome",
          "targets": ["backGo"]
        },
        "backGo": {
          "kind": "move",
          "description": "Moves the released citizen back onto the lattice at that site.",
          "selected": "release",
          "destination": "nearHome"
        },
        "decide": {
          "kind": "rule",
          "label": "Decide State",
          "description": "Epstein's rule for a citizen that is not jailed: count the cops and active citizens in view, estimate the chance of arrest from them, and be active if grievance less the risk of arrest (that chance times risk aversion) is above the active threshold, quiescent otherwise. From Epstein (2002), 'Modeling civil violence: An agent-based computational approach', PNAS 99(suppl. 3), 7243-7250.",
          "space": "lattice",
          "targets": ["notInJail"]
        },
        "notInJail": {
          "kind": "query",
          "description": "Jailed citizens do not decide.",
          "selected": "decide",
          "function": "different",
          "inputs": [
            {
              "attribute": "citizen.state"
            },
            {
              "option": "citizen.state.jailed"
            }
          ],
          "targets": ["clearCops", "clearActive", "copsInView", "activeInView", "activePlusOne"]
        },
        "clearCops": {
          "kind": "set",
          "description": "Starts the count of cops in view at zero.",
          "selected": "decide",
          "attribute": "citizen.copsSeen",
          "parameter": {
            "constant": "zero"
          }
        },
        "clearActive": {
          "kind": "set",
          "description": "Starts the count of active citizens in view at zero.",
          "selected": "decide",
          "attribute": "citizen.activeSeen",
          "parameter": {
            "constant": "zero"
          }
        },
        "copsInView": {
          "kind": "select",
          "description": "Every cop within citizen vision (inclusive), as the legacy count of cops within the vision radius.",
          "selected": "decide",
          "agent": "cop",
          "space": "lattice",
          "targets": ["copRange", "copEvery"]
        },
        "copRange": {
          "kind": "query",
          "selected": "copsInView",
          "function": "within",
          "inputs": [
            {
              "attribute": "citizenVision",
              "selected": "decide"
            }
          ],
          "targets": ["copGroup"]
        },
        "copEvery": {
          "kind": "query",
          "selected": "copsInView",
          "function": "all",
          "targets": ["copGroup"]
        },
        "copGroup": {
          "kind": "all",
          "selected": "copsInView",
          "targets": ["oneMoreCop"]
        },
        "oneMoreCop": {
          "kind": "evaluate",
          "description": "Counts one cop for each cop in view: this act runs once per cop selected.",
          "selected": "decide",
          "function": "increment",
          "inputs": [
            {
              "attribute": "citizen.copsSeen"
            }
          ],
          "targets": ["setCops"]
        },
        "setCops": {
          "kind": "set",
          "selected": "decide",
          "attribute": "citizen.copsSeen",
          "parameter": {
            "evaluate": "oneMoreCop"
          }
        },
        "activeInView": {
          "kind": "select",
          "description": "Every other active citizen within citizen vision (inclusive).",
          "selected": "decide",
          "agent": "citizen",
          "space": "lattice",
          "targets": ["activeRange", "activeEvery", "isActive"]
        },
        "activeRange": {
          "kind": "query",
          "selected": "activeInView",
          "function": "within",
          "inputs": [
            {
              "attribute": "citizenVision",
              "selected": "decide"
            }
          ],
          "targets": ["activeGroup"]
        },
        "activeEvery": {
          "kind": "query",
          "selected": "activeInView",
          "function": "all",
          "targets": ["activeGroup"]
        },
        "isActive": {
          "kind": "query",
          "selected": "activeInView",
          "function": "equal",
          "inputs": [
            {
              "attribute": "citizen.state"
            },
            {
              "option": "citizen.state.active"
            }
          ],
          "targets": ["activeGroup"]
        },
        "activeGroup": {
          "kind": "all",
          "selected": "activeInView",
          "targets": ["oneMoreActive"]
        },
        "oneMoreActive": {
          "kind": "evaluate",
          "description": "Counts one active citizen for each in view: this act runs once per citizen selected.",
          "selected": "decide",
          "function": "increment",
          "inputs": [
            {
              "attribute": "citizen.activeSeen"
            }
          ],
          "targets": ["setActiveSeen"]
        },
        "setActiveSeen": {
          "kind": "set",
          "selected": "decide",
          "attribute": "citizen.activeSeen",
          "parameter": {
            "evaluate": "oneMoreActive"
          }
        },
        "activePlusOne": {
          "kind": "evaluate",
          "description": "Active citizens in view, plus one for the citizen itself, as if it were active. The legacy comment on k: one cop and only this citizen active gives a ratio of 1.",
          "selected": "decide",
          "function": "increment",
          "inputs": [
            {
              "attribute": "citizen.activeSeen"
            }
          ],
          "targets": ["copsPerActive"]
        },
        "copsPerActive": {
          "kind": "evaluate",
          "selected": "decide",
          "function": "div",
          "inputs": [
            {
              "attribute": "citizen.copsSeen"
            },
            {
              "evaluate": "activePlusOne"
            }
          ],
          "targets": ["exponent"]
        },
        "exponent": {
          "kind": "evaluate",
          "selected": "decide",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "copsPerActive"
            },
            {
              "literal": -2.302585092994046,
              "type": "real"
            }
          ],
          "targets": ["unarrested"]
        },
        "unarrested": {
          "kind": "evaluate",
          "selected": "decide",
          "function": "exp",
          "inputs": [
            {
              "evaluate": "exponent"
            }
          ],
          "targets": ["arrestProbability"]
        },
        "arrestProbability": {
          "kind": "evaluate",
          "description": "The estimated probability of arrest, 1 - exp(-k * floor(cops / (active + 1))), with k = -ln 0.1 (2.3026), set so that one cop in view and only this citizen active gives 0.9. As in the legacy code (two Java ints) the quotient is an integer division and truncates, so the estimate is zero unless the cops in view number at least the active citizens plus one. It ends a chain of evaluates that starts at Active plus one.",
          "selected": "decide",
          "function": "sub",
          "inputs": [
            {
              "literal": 1,
              "type": "real"
            },
            {
              "evaluate": "unarrested"
            }
          ],
          "targets": ["perceivedRisk"]
        },
        "perceivedRisk": {
          "kind": "evaluate",
          "selected": "decide",
          "function": "mul",
          "inputs": [
            {
              "evaluate": "arrestProbability"
            },
            {
              "attribute": "citizen.riskAversion"
            }
          ],
          "targets": ["netGrievance"]
        },
        "netGrievance": {
          "kind": "evaluate",
          "description": "Grievance minus the perceived risk, which is the arrest probability times risk aversion.",
          "selected": "decide",
          "function": "sub",
          "inputs": [
            {
              "attribute": "citizen.grievance"
            },
            {
              "evaluate": "perceivedRisk"
            }
          ],
          "targets": ["rebels"]
        },
        "rebels": {
          "kind": "query",
          "description": "Decides the state: a net grievance above the active threshold (strictly) makes the citizen active.",
          "selected": "decide",
          "function": "greater",
          "inputs": [
            {
              "evaluate": "netGrievance"
            },
            {
              "attribute": "activeThreshold"
            }
          ],
          "targets": ["goActive", "stays"]
        },
        "stays": {
          "kind": "none",
          "description": "Otherwise.",
          "selected": "decide",
          "targets": ["goQuiet"]
        },
        "goActive": {
          "kind": "set",
          "description": "Becomes active.",
          "selected": "decide",
          "attribute": "citizen.state",
          "parameter": {
            "option": "citizen.state.active"
          }
        },
        "goQuiet": {
          "kind": "set",
          "description": "Becomes quiescent.",
          "selected": "decide",
          "attribute": "citizen.state",
          "parameter": {
            "option": "citizen.state.quiescent"
          }
        }
      },
      "styles": {
        "citizenStyle": {
          "kind": "2d",
          "description": "Round marks: red for an active citizen, blue for any other, as in the original's agent view. The original's second view, colouring each site by the grievance of the citizen on it, and its legend, are not expressed.",
          "acts": {
            "look": {
              "kind": "rule",
              "description": "Draws an active citizen as a red circle and any other as a blue circle.",
              "space": "lattice",
              "targets": ["rebelling"]
            },
            "rebelling": {
              "kind": "query",
              "selected": "look",
              "function": "equal",
              "inputs": [
                {
                  "attribute": "citizen.state"
                },
                {
                  "option": "citizen.state.active"
                }
              ],
              "targets": ["red", "quiet"]
            },
            "quiet": {
              "kind": "none",
              "selected": "look",
              "targets": ["blue"]
            },
            "red": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorRed",
              "targets": ["redOval"]
            },
            "redOval": {
              "kind": "evaluate",
              "selected": "look",
              "function": "shapeOval",
              "targets": ["redFill"]
            },
            "redFill": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            },
            "blue": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorBlue",
              "targets": ["blueOval"]
            },
            "blueOval": {
              "kind": "evaluate",
              "selected": "look",
              "function": "shapeOval",
              "targets": ["blueFill"]
            },
            "blueFill": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            }
          }
        }
      }
    },
    "cop": {
      "kind": "agent",
      "extends": "person",
      "label": "Cop",
      "description": "Jails the nearest active citizen in view, takes its site, and walks. Cops walk whether citizens do or not, so they use the person's `walk` as it is; their rules run in the order patrol, walk, withdraw.",
      "pluralLabel": "Cops",
      "attributes": {
        "rank": {
          "type": "real",
          "label": "Rank",
          "description": "A fixed draw from 0 to 1, used only by Withdraw to let the cop count fall in Run 5. The original has no such attribute."
        }
      },
      "acts": {
        "place": {
          "kind": "initialize",
          "label": "Place",
          "description": "Setup: the cop moves to a random free site and draws its rank.",
          "space": "lattice",
          "targets": ["startSite", "drawRank"]
        },
        "drawRank": {
          "kind": "evaluate",
          "selected": "place",
          "function": "randomUnit",
          "targets": ["setRank"]
        },
        "setRank": {
          "kind": "set",
          "selected": "place",
          "attribute": "cop.rank",
          "parameter": {
            "evaluate": "drawRank"
          }
        },
        "patrol": {
          "kind": "rule",
          "label": "Patrol",
          "description": "Arrests the nearest active citizen within cop vision, if there is one: the citizen is jailed and removed from the lattice, and the cop moves into its site (the legacy Cop.patrol).",
          "space": "lattice",
          "targets": ["target"]
        },
        "target": {
          "kind": "select",
          "description": "The active citizen to arrest: the nearest active one within cop vision.",
          "selected": "patrol",
          "agent": "citizen",
          "space": "lattice",
          "targets": ["inReach", "closest", "rebelling"]
        },
        "inReach": {
          "kind": "query",
          "description": "Within cop vision. This is inclusive; the coded port and Ascape's search for the nearest are strict (below vision), so the two differ only for a target exactly at the vision, vision 7 for example.",
          "selected": "target",
          "function": "within",
          "inputs": [
            {
              "attribute": "copVision",
              "selected": "patrol"
            }
          ],
          "targets": ["candidate"]
        },
        "closest": {
          "kind": "query",
          "selected": "target",
          "function": "nearest",
          "targets": ["candidate"]
        },
        "rebelling": {
          "kind": "query",
          "description": "Only active citizens are candidates.",
          "selected": "target",
          "function": "equal",
          "inputs": [
            {
              "attribute": "citizen.state"
            },
            {
              "option": "citizen.state.active"
            }
          ],
          "targets": ["candidate"]
        },
        "candidate": {
          "kind": "all",
          "selected": "target",
          "targets": ["arrestSite"]
        },
        "arrestSite": {
          "kind": "select",
          "description": "The site the target stands on, found before the citizen leaves it so the cop can move there afterwards.",
          "selected": "target",
          "agent": "site",
          "space": "lattice",
          "targets": ["arrestHere"]
        },
        "arrestHere": {
          "kind": "query",
          "selected": "arrestSite",
          "function": "here",
          "targets": ["jail", "drawTerm", "homeX", "homeY", "removed", "takePlace"]
        },
        "jail": {
          "kind": "set",
          "description": "The target becomes jailed.",
          "selected": "target",
          "attribute": "citizen.state",
          "parameter": {
            "option": "citizen.state.jailed"
          }
        },
        "drawTerm": {
          "kind": "evaluate",
          "description": "The target's jail term, drawn uniformly from 0 to the jail term, both ends included. At the jail term 2147483647 the original sets the term to that value and draws nothing; this draw is made anyway, which in a run of a few hundred periods all but never releases a citizen.",
          "selected": "patrol",
          "function": "randomInRange",
          "inputs": [
            {
              "literal": 0
            },
            {
              "attribute": "jailTerm"
            }
          ],
          "targets": ["setTerm"]
        },
        "setTerm": {
          "kind": "set",
          "selected": "target",
          "attribute": "citizen.jailTermsLeft",
          "parameter": {
            "evaluate": "drawTerm"
          }
        },
        "homeX": {
          "kind": "evaluate",
          "description": "Column of the arrest site, kept so that release can find the place again.",
          "selected": "arrestSite",
          "function": "locationX",
          "targets": ["setHomeX"]
        },
        "setHomeX": {
          "kind": "set",
          "selected": "target",
          "attribute": "citizen.homeX",
          "parameter": {
            "evaluate": "homeX"
          }
        },
        "homeY": {
          "kind": "evaluate",
          "description": "Row of the arrest site, kept so that release can find the place again.",
          "selected": "arrestSite",
          "function": "locationY",
          "targets": ["setHomeY"]
        },
        "setHomeY": {
          "kind": "set",
          "selected": "target",
          "attribute": "citizen.homeY",
          "parameter": {
            "evaluate": "homeY"
          }
        },
        "removed": {
          "kind": "leave",
          "description": "The jailed citizen leaves the lattice.",
          "selected": "target"
        },
        "takePlace": {
          "kind": "move",
          "description": "The cop moves into the arrest site, which the citizen has left.",
          "selected": "patrol",
          "destination": "arrestSite"
        },
        "withdraw": {
          "kind": "rule",
          "label": "Withdraw",
          "description": "Run 5 only: lets the number of cops fall with the target cop density. The original corrected the count to the target, rounded down, after each period's data sample, killing random cops or adding new ones. Here each cop has a fixed rank and retires when its rank times the initial cop density is at or above the density now, so the count is binomial around the target and not equal to it, and no cop is ever added. The run starts at its 6% target directly; the coded run shows 7.4% for one period first. With a step of 0, the default, no cop is withdrawn.",
          "space": "lattice",
          "targets": ["scaledRank"]
        },
        "scaledRank": {
          "kind": "evaluate",
          "description": "The cop's rank times the initial cop density.",
          "selected": "withdraw",
          "function": "mul",
          "inputs": [
            {
              "attribute": "cop.rank"
            },
            {
              "attribute": "initialCopDensity"
            }
          ],
          "targets": ["now"]
        },
        "now": {
          "kind": "evaluate",
          "selected": "withdraw",
          "function": "timeNow",
          "targets": ["cut"]
        },
        "cut": {
          "kind": "evaluate",
          "selected": "withdraw",
          "function": "mul",
          "inputs": [
            {
              "attribute": "copDensityStep"
            },
            {
              "evaluate": "now"
            }
          ],
          "targets": ["remaining"]
        },
        "remaining": {
          "kind": "evaluate",
          "description": "The cop density now: the initial cop density less the step times the period.",
          "selected": "withdraw",
          "function": "sub",
          "inputs": [
            {
              "attribute": "initialCopDensity"
            },
            {
              "evaluate": "cut"
            }
          ],
          "targets": ["surplus"]
        },
        "surplus": {
          "kind": "query",
          "description": "True when the cop's scaled rank is at or above the density now, so there are more cops than the density allows.",
          "selected": "withdraw",
          "function": "greaterorEqual",
          "inputs": [
            {
              "evaluate": "scaledRank"
            },
            {
              "evaluate": "remaining"
            }
          ],
          "targets": ["retire"]
        },
        "retire": {
          "kind": "die",
          "description": "The cop is withdrawn.",
          "selected": "withdraw"
        }
      },
      "styles": {
        "copStyle": {
          "kind": "2d",
          "description": "Black circles, as in the original's agent view.",
          "acts": {
            "look": {
              "kind": "rule",
              "description": "Draws a cop as a black circle.",
              "space": "lattice",
              "targets": ["black"]
            },
            "black": {
              "kind": "evaluate",
              "selected": "look",
              "function": "colorBlack",
              "targets": ["blackOval"]
            },
            "blackOval": {
              "kind": "evaluate",
              "selected": "look",
              "function": "shapeOval",
              "targets": ["blackFill"]
            },
            "blackFill": {
              "kind": "evaluate",
              "selected": "look",
              "function": "graphicFill"
            }
          }
        }
      },
      "execution": {
        "rules": ["patrol", "walk", "withdraw"]
      }
    }
  },
  "spaces": {
    "lattice": {
      "kind": "grid",
      "label": "Lattice",
      "description": "The cells the citizens and cops stand on, 40 by 40 by default. Edges wrap, so the lattice is a torus. Distance is Euclidean, as in Ascape's vision search. The legacy size was fixed at 40 by 40.",
      "neighborhood": "euclidean",
      "borderRule": "periodic",
      "dimensions": ["width", "height"],
      "attributes": {
        "width": {
          "type": "integer",
          "label": "Width",
          "description": "Number of columns (legacy: fixed at 40).",
          "default": 40,
          "min": 5,
          "max": 200
        },
        "height": {
          "type": "integer",
          "label": "Height",
          "description": "Number of rows (legacy: fixed at 40).",
          "default": 40,
          "min": 5,
          "max": 200
        }
      }
    }
  }
}
