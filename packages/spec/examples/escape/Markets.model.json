  "acts": {
    "buildTrading": {
      "kind": "build",
      "label": "Build Trading",
      "pluralLabel": "Build Tradings",
      "targets": [
        "createTraders",
        "createFirms",
        "buildInstrumentHolder",
        "buildFirmInstruments",
        "buildBidFirmss"
      ]
    },
    "createTraders": {
      "kind": "create",
      "label": "Create Traders",
      "selected": "buildTrading",
      "agent": "trader",
      "agentCount": {
        "attribute": "traderCount"
      }
    },
    "createFirms": {
      "kind": "create",
      "label": "Create Firms",
      "selected": "buildTrading",
      "agent": "firm",
      "agentCount": {
        "attribute": "firmCount"
      }
    },
    "buildInstrumentHolder": {
      "kind": "buildNetwork",
      "label": "Build Instrument Holder",
      "pluralLabel": "Build Instrument Holders",
      "selected": "buildTrading",
      "agents": [
        "instrument",
        "trader"
      ],
      "space": "instrumentHolders"
    },
    "buildFirmInstruments": {
      "kind": "buildNetwork",
      "label": "Build Firm Instruments",
      "pluralLabel": "Build Firm Instrumentss",
      "selected": "buildTrading",
      "agents": [
        "firm",
        "instrument"
      ],
      "space": "firmInstruments"
    },
    "buildBidFirmss": {
      "kind": "buildNetwork",
      "label": "Build Bid Firmss",
      "pluralLabel": "Build Bid Firmsss",
      "selected": "buildTrading",
      "agents": [
        "trader",
        "firm"
      ],
      "space": "targetBuyFirms"
    }
  },
  "agents": {
