          "kind": "query",
          "label": "Neighbor() Query Copy Copy",
          "selected": "firm",
          "function": "neighbor",
          "targets": [
            "boughtInstrument"
          ]
        },
        "offerPriceAddZero": {
          "kind": "evaluate",
          "label": "Offer Price Add Zero",
