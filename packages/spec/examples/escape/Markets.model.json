        "neighborQueryCopyCopyCopy": {
          "kind": "query",
          "label": "Neighbor() Query Copy Copy Copy",
          "selected": "boughtInstrument",
          "function": "neighbor",
          "targets": [
            "_Minimize_FirmPriceEarningsRatio_QueryAndStrategyIdenticalValueQueryAndTotalPriceLesserorEqualFundsQueryAndStatusIdenticalOfferredQuery_"
