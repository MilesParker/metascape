          "selected": "ask",
          "function": "uniformAdditiveDistribution",
          "inputs": [
            {
              "multiValue": []
            },
            {
              "multiValue": [
                "sharePriceAdjustmentMinimum"
              ]
            },
            {
              "multiValue": [
                "sharePriceAdjustmentMaximum"
              ]
            }
          ],
          "targets": [
            "newSharePrice"
          ]
