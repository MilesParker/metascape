              "attribute": "trader.funds",
              "selected": "execute"
            },
            {
              "attribute": "instrument.totalPrice"
            }
          ],
          "targets": [
            "setFundsToFundsSubtractTotalPrice"
          ]
        },
        "setFundsToFundsSubtractTotalPrice": {
          "kind": "set",
          "label": "Set Funds To Funds Subtract Total Price",
