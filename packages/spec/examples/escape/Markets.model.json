        "strategy": {
          "type": "state",
          "label": "Strategy",
          "pluralLabel": "Strategys",
          "options": {
            "value": {
              "label": "Value",
              "pluralLabel": "Values"
            },
            "momentum": {
              "label": "Momentum",
              "pluralLabel": "Momentums"
            },
            "random": {
              "label": "Random",
              "pluralLabel": "Randoms"
            }
          },
          "defaultOption": "random"
        },
        "funds": {
          "type": "real",
          "label": "Funds",
          "pluralLabel": "Fundss",
          "gatherData": true,
          "default": 100000
        },
        "instrumentCount": {
          "type": "integer",
          "label": "Instrument Count",
          "pluralLabel": "Instrument Counts",
          "gatherData": true
        }
      },
      "acts": {
        "initialize": {
          "kind": "initialize",
          "label": "Initialize",
          "pluralLabel": "Initializes",
          "targets": [
            "randomState_Strategy_",
            "initialTraderFunds"
          ]
        },
        "randomState_Strategy_": {
          "kind": "evaluate",
          "label": "Random State(Strategy)",
          "selected": "initialize",
          "function": "randomState",
          "inputs": [
            {
              "attribute": "trader.strategy"
            }
          ],
          "targets": [
            "setStrategyToRandomState_Strategy_"
          ]
        },
        "setStrategyToRandomState_Strategy_": {
          "kind": "set",
          "label": "Set Strategy To Random State(Strategy)",
          "selected": "initialize",
          "attribute": "trader.strategy",
          "parameter": {
            "evaluate": "randomState_Strategy_"
          }
        },
        "ask": {
          "kind": "rule",
          "label": "Ask",
          "pluralLabel": "Asks",
          "description": "",
          "targets": [
            "selling"
          ]
        },
        "selling": {
          "kind": "select",
          "label": "Selling",
          "selected": "ask",
          "agent": "instrument",
          "space": "instrumentHolders",
          "targets": [
            "neighborQuery",
            "statusIdenticalHeldQuery"
          ]
        },
        "buy": {
          "kind": "rule",
          "label": "Buy",
          "pluralLabel": "Buys",
          "targets": [
            "disconnectCopy"
          ]
        },
        "boughtInstrument": {
          "kind": "select",
          "label": "Bought Instrument",
