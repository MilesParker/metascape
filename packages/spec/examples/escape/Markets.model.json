          "kind": "evaluate",
          "label": "Funds Add Total Price",
          "selected": "seller",
          "function": "add",
          "inputs": [
            {
              "attribute": "trader.funds"
            },
            {
              "attribute": "instrument.totalPrice",
              "selected": "boughtInstrument"
            }
          ],
          "targets": [
            "setFundsToFundsAddTotalPrice"
          ]
        },
        "setFundsToFundsAddTotalPrice": {
          "kind": "set",
          "label": "Set Funds To Funds Add Total Price",
          "selected": "seller",
