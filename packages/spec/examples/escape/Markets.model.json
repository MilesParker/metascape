    "sharePriceAdjustmentMaximum": {
      "type": "real",
      "label": "Share Price Adjustment Maximum",
      "pluralLabel": "Share Price Adjustment Maximums",
      "default": 1.02
    },
    "initialFirmPriceMinimum": {
      "type": "real",
      "label": "Initial Firm Price Minimum",
      "pluralLabel": "Initial Firm Price Minimums",
      "default": 10
    },
    "initialFirmPriceMaximum": {
      "type": "real",
      "label": "Initial Firm Price Maximum",
      "pluralLabel": "Initial Firm Price Maximums",
      "default": 30
    },
    "initialTraderFundsMinimum": {
      "type": "real",
      "label": "Initial Trader Funds Minimum",
      "pluralLabel": "Initial Trader Funds Minimums",
      "default": 50000
    },
    "initialTraderFundsMaximum": {
      "type": "real",
      "label": "Initial Trader Funds Maximum",
      "pluralLabel": "Initial Trader Funds Maximums",
      "default": 50000
    },
    "firmSharesCount": {
      "type": "integer",
      "label": "Firm Shares Count",
      "pluralLabel": "Firm Shares Counts",
      "default": 10000
