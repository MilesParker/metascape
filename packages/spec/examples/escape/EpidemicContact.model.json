{
  "schemaVersion": 2,
  "id": "epidemic",
  "label": "Epidemic",
  "pluralLabel": "Epidemics",
  "description": "A simple model of epidemic dynamics. We define individual agents with different disease states. The progression of disease moves from succeptible to exposed to infectious (either symptomatic or asymptomatic) to some outcome state. Agents can transmit infection to their immediate neighbors. \n\nFor some background on the general approach, see Joshua M. Epstein. \"Generative Social Science\". 2006. Princeton. \n\nCopyright 2009, Miles Parker. Released under Eclipse Public License. All uses should be attributed.",
  "language": "typescript",
  "attributes": {
    "individualCount": {
      "type": "integer",
      "label": "Individual Count",
      "pluralLabel": "Individual Counts",
      "description": "The number of individuals to create.",
      "default": 1500
    },
    "initialInfectionProbability": {
      "type": "real",
      "label": "Initial Infection Probability",
      "pluralLabel": "Initial Infection Probabilitys",
      "description": "The probability that any given individual will be infected at the beginning of the model run. For example, if this value is .15, and their are 100 individuals in the model, roughly 15 of those individuals will be infected at time 0.",
      "default": 0.005
    },
    "minContactTransmissionProbability": {
      "type": "real",
      "label": "Min Contact Transmission Probability",
      "pluralLabel": "Min Contact Transmission Probabilitys",
      "description": "The minimum probability that proximity to a single neighbor for a single period will result in transmission of infection. At the start of each model run, each individual is assigned a contact transmission probability between the minimum and maximum value. For example, if this value was .08 and the maximum value was 0.12 a given individual could have any value between those two, but the average transmission probability would be around .1. If minium and maximum values are the same, then all individuals will have the same chance of passing along infection to a given neighbor. This value must be between 0.0 and 1.0 and less than or equal to Max Contact transmission Probability.",
      "default": 0.08
    },
    "maxContactTransmissionProbability": {
      "type": "real",
      "label": "Max Contact Transmission Probability",
      "pluralLabel": "Max Contact Transmission Probabilitys",
      "description": "The maximum probability that proximity to a single neighbor for a single period will result in transmission of infection. See Min Contact Probability for more information. Must be a value between 0.0 and 1.0 and greater or equal to Min Contact Transmission Probability.",
      "default": 0.16
    },
    "caseMortalityRate": {
      "type": "real",
      "label": "Case Mortality Rate",
      "pluralLabel": "Case Mortality Rates",
      "description": "The current probability that death will occur for a given individual as a result of infection. Some number between 0.0 and 1.0.",
      "default": 0.05
    },
    "periodsperDay": {
      "type": "integer",
      "label": "Periods per Day",
      "pluralLabel": "Periods per Days",
      "default": 24
    },
    "minPeriodExposure": {
      "type": "integer",
      "label": "Min Period Exposure",
      "pluralLabel": "Min Period Exposures",
      "description": "The minimum amount of time from initial exposure to infectious asymptomatic or symptomatic state. 0 or greater.",
      "default": 24
    },
    "maxPeriodExposure": {
      "type": "integer",
      "label": "Max Period Exposure",
      "pluralLabel": "Max Period Exposures",
      "description": "Maximum time from initial exposure to infectious asymptomatic or symptomatic state. 0 or greater.",
      "default": 72
    },
    "minPeriodAsymptomInfection": {
      "type": "integer",
      "label": "Min Period Asymptom Infection",
      "pluralLabel": "Min Period Asymptom Infections",
      "description": "Maximum time spent infected without showing symptoms. 0 or greater.",
      "default": 24
    },
    "maxPeriodAsymptomInfection": {
      "type": "integer",
      "label": "Max Period Asymptom Infection",
      "pluralLabel": "Max Period Asymptom Infections",
      "description": "Maximum time spent infected without showing symptoms. May be zero!",
      "default": 96
    },
    "minPeriodSymptomInfection": {
      "type": "integer",
      "label": "Min Period Symptom Infection",
      "pluralLabel": "Min Period Symptom Infections",
      "description": "Minimum time spent infected with obvious symptoms. 0 or greater.",
      "default": 24
    },
    "maxPeriodSymptomInfection": {
      "type": "integer",
      "label": "Max Period Symptom Infection",
      "pluralLabel": "Max Period Symptom Infections",
      "description": "Maximum time spent infected with obvious symptoms. 1 or greater.",
      "default": 168
    },
    "movementProbability": {
      "type": "real",
      "label": "Movement Probability",
      "pluralLabel": "Movement Probabilitys",
      "description": "The chance that an agent will move within a given period. May be any value between 0.0 and 1.0.",
      "default": 0.5
    }
  },
  "acts": {
    "buildEpidemic": {
      "kind": "build",
      "label": "Build Epidemic",
      "pluralLabel": "Build Epidemics",
      "targets": [
        "createIndividuals",
        "buildCity",
        "buildNetworks"
      ]
    },
    "createIndividuals": {
      "kind": "create",
      "label": "Create Individuals",
      "selected": "buildEpidemic",
      "agent": "individual",
      "agentCount": {
        "attribute": "individualCount"
      }
    },
    "buildCity": {
      "kind": "buildGrid",
      "label": "Build City",
      "pluralLabel": "Build Citys",
      "selected": "buildEpidemic",
      "agents": [
        "individual"
      ],
      "space": "city"
    },
    "buildNetworks": {
      "kind": "buildNetwork",
      "label": "Build Networks",
      "pluralLabel": "Build Networkss",
      "selected": "buildEpidemic",
      "agents": [
        "individual"
      ],
      "space": "contacts"
    }
  },
  "agents": {
    "individual": {
      "kind": "agent",
      "label": "Individual",
      "pluralLabel": "Individuals",
      "attributes": {
        "status": {
          "type": "state",
          "label": "Status",
          "pluralLabel": "Statuss",
          "gatherData": true,
          "options": {
            "susceptible": {
              "label": "Susceptible",
              "pluralLabel": "Susceptibles"
            },
            "exposed": {
              "label": "Exposed",
              "pluralLabel": "Exposeds"
            },
            "asymptomInfectious": {
              "label": "Asymptom Infectious",
              "pluralLabel": "Asymptom Infectiouss"
            },
            "symptomInfectious": {
              "label": "Symptom Infectious",
              "pluralLabel": "Symptom Infectiouss"
            },
            "recovered": {
              "label": "Recovered",
              "pluralLabel": "Recovereds"
            },
            "dead": {
              "label": "Dead",
              "pluralLabel": "Deads"
            }
          },
          "defaultOption": "susceptible"
        },
        "exposureEndPeriod": {
          "type": "integer",
          "label": "Exposure End Period",
          "pluralLabel": "Exposure Days",
          "gatherData": true
        },
        "asymptomaticEndPeriod": {
          "type": "integer",
          "label": "Asymptomatic End Period",
          "pluralLabel": "Asymptomatic End Periods"
        },
        "outcomePeriod": {
          "type": "integer",
          "label": "Outcome Period",
          "pluralLabel": "Outcome Periods"
        },
        "contactTransmissionProbability": {
          "type": "real",
          "label": "Contact Transmission Probability",
          "pluralLabel": "Contact Transmission Probabilites",
          "gatherData": true
        }
      },
      "acts": {
        "initializeLocation": {
          "kind": "initialize",
          "label": "Initialize Location",
